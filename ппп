import tkinter as tk
from tkinter import messagebox

class CalculatorApp:
    def __init__(self, root):
        self.root = root
        self.root.title("PyCalc Linux Edition")
        self.root.geometry("300x400")
        
        self.result_var = tk.StringVar()
        
        # Поле вводу
        entry = tk.Entry(root, textvariable=self.result_var, font=("Arial", 24), bd=10, insertwidth=4, width=14, justify='right')
        entry.grid(row=0, column=0, columnspan=4)

        # Кнопки
        buttons = [
            '7', '8', '9', '/',
            '4', '5', '6', '*',
            '1', '2', '3', '-',
            'C', '0', '=', '+'
        ]

        row = 1
        col = 0
        for button in buttons:
            action = lambda x=button: self.on_click(x)
            tk.Button(root, text=button, width=5, height=2, font=("Arial", 14), command=action).grid(row=row, column=col)
            col += 1
            if col > 3:
                col = 0
                row += 1

    def on_click(self, char):
        if char == '=':
            try:
                # Використовуємо eval для розрахунку (для лаби це ок)
                result = str(eval(self.result_var.get()))
                self.result_var.set(result)
            except Exception:
                messagebox.showerror("Помилка", "Неправильний вираз")
                self.result_var.set("")
        elif char == 'C':
            self.result_var.set("")
        else:
            self.result_var.set(self.result_var.get() + char)

if __name__ == "__main__":
    root = tk.Tk()
    app = CalculatorApp(root)
    root.mainloop()
